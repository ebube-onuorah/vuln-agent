# Advanced Vulnerability Predictor — environment variables
# Copy this to .env and fill in your values. Never commit .env to git.

# ─── API Auth ─────────────────────────────────────────────────────────────────
# Leave blank for open/dev mode. Set to a random string for production.
API_KEY=

# ─── GitHub Integration ───────────────────────────────────────────────────────
# Personal access token — optional for public repos, required for private.
# Increases GitHub API rate limit from 60/hr to 5000/hr.
GITHUB_TOKEN=
